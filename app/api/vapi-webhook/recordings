import { NextResponse } from "next/server";

export async function GET(request, { params }) {
  const { id } = params;
  const privateKey = process.env.VAPI_PRIVATE_API_KEY;

  if (!privateKey) {
    return NextResponse.json({ error: "Missing VAPI_PRIVATE_API_KEY" }, { status: 500 });
  }

  try {
    // 1. Call Vapi's stereo recording endpoint with your private server key
    const vapiRes = await fetch(`https://api.vapi.ai/call/${id}/stereo-recording`, {
      headers: {
        Authorization: `Bearer ${privateKey}`,
      },
      redirect: "follow", // Follow Vapi's 302 internally on the server
    });

    if (!vapiRes.ok) {
      return NextResponse.json({ error: "Recording not ready or not found" }, { status: 404 });
    }

    // 2. Read the audio binary data safely on the server
    const audioBuffer = await vapiRes.arrayBuffer();

    // 3. Stream the raw audio bytes directly to the browser element
    return new NextResponse(audioBuffer, {
      headers: {
        "Content-Type": "audio/mpeg",
        "Accept-Ranges": "bytes",
        "Content-Length": audioBuffer.byteLength.toString(),
      },
    });
  } catch (error) {
    console.error("Error streaming recording proxy:", error);
    return NextResponse.json({ error: "Internal Server Error" }, { status: 500 });
  }
}