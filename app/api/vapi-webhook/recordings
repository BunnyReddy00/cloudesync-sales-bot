import { NextResponse } from "next/server";

export async function GET(request, { params }) {
  const { id } = params;
  const privateKey = process.env.VAPI_PRIVATE_API_KEY;

  if (!privateKey) {
    return NextResponse.json({ error: "Missing VAPI_PRIVATE_API_KEY" }, { status: 500 });
  }

  try {
    const response = await fetch(`https://api.vapi.ai/call/${id}/stereo-recording`, {
      headers: {
        Authorization: `Bearer ${privateKey}`,
      },
      redirect: "follow",
    });

    if (!response.ok) {
      return NextResponse.json({ error: "Recording not ready yet" }, { status: 404 });
    }

    const audioBuffer = await response.arrayBuffer();

    return new NextResponse(audioBuffer, {
      headers: {
        "Content-Type": "audio/mpeg",
        "Accept-Ranges": "bytes",
        "Content-Length": audioBuffer.byteLength.toString(),
      },
    });
  } catch (error) {
    console.error("Error proxying recording:", error);
    return NextResponse.json({ error: "Internal Server Error" }, { status: 500 });
  }
}