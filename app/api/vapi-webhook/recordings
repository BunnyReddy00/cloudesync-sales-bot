import { NextResponse } from 'next/server';

export async function GET(req) {
  const { searchParams } = new URL(req.url);
  const callId = searchParams.get('id');

  if (!callId) {
    return NextResponse.json({ error: 'Missing call ID' }, { status: 400 });
  }

  try {
    const vapiRes = await fetch(`https://api.vapi.ai/call/${callId}/stereo-recording`, {
      headers: {
        'Authorization': `Bearer ${process.env.VAPI_PRIVATE_API_KEY}`
      },
      redirect: 'manual'
    });

    const location = vapiRes.headers.get('location');
    if (location) {
      const res = NextResponse.redirect(location);
      // Add CORS headers so the browser allows audio streaming
      res.headers.set('Access-Control-Allow-Origin', '*');
      return res;
    }

    return NextResponse.json({ error: 'Recording not found' }, { status: 404 });
  } catch (err) {
    console.error('Error proxying recording:', err);
    return NextResponse.json({ error: 'Internal Server Error' }, { status: 500 });
  }
}